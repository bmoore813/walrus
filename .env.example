# .env.example — copy to .env (`cp .env.example .env`) for local dev.
#
# Both binaries load this same versioned YAML file. Flat `WALRUS_*` variables can still override
# values for one process; shared keys route under `common`, while all other keys route under the
# service being launched.
WALRUS_CONFIG=walrus.yaml

# --- object-store credentials (consumed by the S3 client, not by walrus-config) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
