---
source: crates/transformer/src/transform_test.rs
expression: interval.render_rebuild(None)
---
CREATE OR REPLACE TEMP TABLE "_walrus_rebuild_events" AS WITH src AS (SELECT s.id AS id, to_months(s.elapsed_months) + to_days(s.elapsed_days) + to_microseconds(s.elapsed_micros) AS elapsed, s.walrus_extractor_meta AS walrus_extractor_meta, s._walrus_op AS _walrus_op, s._walrus_commit_lsn AS _walrus_commit_lsn, s._walrus_lsn AS _walrus_lsn FROM "events_raw" s WHERE s._walrus_op <> 't' UNION ALL BY NAME SELECT id, elapsed, '{}' AS walrus_extractor_meta, 'i' AS _walrus_op, _applied_commit_lsn AS _walrus_commit_lsn, _applied_lsn AS _walrus_lsn FROM "events"), winners AS (SELECT * FROM src QUALIFY row_number() OVER (PARTITION BY id ORDER BY _walrus_commit_lsn DESC, _walrus_lsn DESC, CASE WHEN _walrus_op = 'd' THEN 0 ELSE 1 END DESC) = 1) SELECT s.id AS id, CASE WHEN COALESCE(json_extract_string(s.walrus_extractor_meta, '$.unchanged_toast'), '[]') LIKE '%"elapsed"%' ESCAPE '\' THEN COALESCE(( WITH RECURSIVE _walrus_toast_lineage(_walrus_depth, _walrus_key_0, _walrus_upper_commit_lsn, _walrus_upper_lsn, _walrus_has_edge, _walrus_edge_commit_lsn, _walrus_edge_lsn, _walrus_old_key_0) AS ( SELECT 0, s.id, s._walrus_commit_lsn, s._walrus_lsn, edge._walrus_edge_found IS NOT NULL, edge._walrus_edge_commit_lsn, edge._walrus_edge_lsn, edge._walrus_old_key_0 FROM (VALUES (TRUE)) AS seed(_walrus_dummy) LEFT JOIN LATERAL (SELECT TRUE AS _walrus_edge_found, u._walrus_commit_lsn AS _walrus_edge_commit_lsn, u._walrus_lsn AS _walrus_edge_lsn, d.id AS _walrus_old_key_0 FROM "events_raw" u JOIN "events_raw" d ON d._walrus_op = 'd' AND d._walrus_commit_lsn IS NOT DISTINCT FROM u._walrus_commit_lsn AND d._walrus_lsn IS NOT DISTINCT FROM u._walrus_lsn WHERE u._walrus_op = 'u' AND u.id IS NOT DISTINCT FROM (s.id) AND (u._walrus_commit_lsn, u._walrus_lsn) <= (s._walrus_commit_lsn, s._walrus_lsn) AND NOT (d.id IS NOT DISTINCT FROM u.id) ORDER BY u._walrus_commit_lsn DESC, u._walrus_lsn DESC LIMIT 1) edge ON TRUE UNION ALL SELECT lineage._walrus_depth + 1, lineage._walrus_old_key_0, lineage._walrus_edge_commit_lsn, lineage._walrus_edge_lsn, edge._walrus_edge_found IS NOT NULL, edge._walrus_edge_commit_lsn, edge._walrus_edge_lsn, edge._walrus_old_key_0 FROM _walrus_toast_lineage lineage LEFT JOIN LATERAL (SELECT TRUE AS _walrus_edge_found, u._walrus_commit_lsn AS _walrus_edge_commit_lsn, u._walrus_lsn AS _walrus_edge_lsn, d.id AS _walrus_old_key_0 FROM "events_raw" u JOIN "events_raw" d ON d._walrus_op = 'd' AND d._walrus_commit_lsn IS NOT DISTINCT FROM u._walrus_commit_lsn AND d._walrus_lsn IS NOT DISTINCT FROM u._walrus_lsn WHERE u._walrus_op = 'u' AND u.id IS NOT DISTINCT FROM (lineage._walrus_old_key_0) AND (u._walrus_commit_lsn, u._walrus_lsn) < (lineage._walrus_edge_commit_lsn, lineage._walrus_edge_lsn) AND NOT (d.id IS NOT DISTINCT FROM u.id) ORDER BY u._walrus_commit_lsn DESC, u._walrus_lsn DESC LIMIT 1) edge ON TRUE WHERE lineage._walrus_has_edge ) SELECT COALESCE(raw_value._walrus_value, mirror_value._walrus_value) FROM _walrus_toast_lineage lineage LEFT JOIN LATERAL ( SELECT list_value(to_months(r.elapsed_months) + to_days(r.elapsed_days) + to_microseconds(r.elapsed_micros)) AS _walrus_value FROM "events_raw" r WHERE r.id IS NOT DISTINCT FROM lineage._walrus_key_0 AND r._walrus_op NOT IN ('d', 't') AND NOT (COALESCE(json_extract_string(r.walrus_extractor_meta, '$.unchanged_toast'), '[]') LIKE '%"elapsed"%' ESCAPE '\') AND (r._walrus_commit_lsn, r._walrus_lsn) <= (lineage._walrus_upper_commit_lsn, lineage._walrus_upper_lsn) AND (NOT lineage._walrus_has_edge OR (r._walrus_commit_lsn, r._walrus_lsn) >= (lineage._walrus_edge_commit_lsn, lineage._walrus_edge_lsn)) ORDER BY r._walrus_commit_lsn DESC, r._walrus_lsn DESC LIMIT 1 ) raw_value ON TRUE LEFT JOIN LATERAL ( SELECT list_value(m.elapsed) AS _walrus_value FROM "events" m WHERE m.id IS NOT DISTINCT FROM lineage._walrus_key_0 LIMIT 1 ) mirror_value ON TRUE WHERE raw_value._walrus_value IS NOT NULL OR mirror_value._walrus_value IS NOT NULL ORDER BY lineage._walrus_depth LIMIT 1 ), list_value(t.elapsed))[1] ELSE s.elapsed END AS elapsed, s._walrus_commit_lsn AS _applied_commit_lsn, s._walrus_lsn AS _applied_lsn FROM winners s LEFT JOIN "events" t ON t.id IS NOT DISTINCT FROM s.id WHERE s._walrus_op <> 'd'; DROP VIEW IF EXISTS "events_current"; CREATE OR REPLACE TABLE "events" AS SELECT * FROM "_walrus_rebuild_events"; DROP TABLE "_walrus_rebuild_events"; CREATE OR REPLACE VIEW "events_current" AS
SELECT * EXCLUDE (_applied_commit_lsn, _applied_lsn) FROM "events";
